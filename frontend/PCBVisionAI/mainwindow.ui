            <property name="styleSheet">
             <string notr="true">QPushButton#btnStart {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(43, 240, 200, 230),
        stop:1 rgba(22, 201, 120, 230)
