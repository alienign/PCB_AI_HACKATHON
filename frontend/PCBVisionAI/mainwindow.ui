    border-radius: 14px;
    padding: 12px 22px;

    font-size: 16px;
    font-weight: 600;
}

QPushButton#btnStart:hover {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(70, 255, 220, 245),
        stop:1 rgba(35, 220, 140, 245)
    );
    border: 1px solid rgba(130, 255, 230, 220);
}

QPushButton#btnStart:pressed {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(28, 210, 170, 230),
        stop:1 rgba(18, 170, 105, 230)
    );
    padding-left: 14px;
    padding-top: 13px;
}

QPushButton#btnStart:disabled {
    background-color: rgba(40, 100, 90, 160);
    color: rgba(255, 255, 255, 140);
    border: 1px solid rgba(80, 130, 120, 120);
}</string>
